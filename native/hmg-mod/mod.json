{
  "id": "moon-studio",
  "name": "Moon Studio Lighting (TEST)",
  "version": "0.2.0",
  "hmgapi": ">=1.0.0",
  "authors": [
    "Moon Studio contributors"
  ],
  "license": "AGPL-3.0",
  "description": "Moon Studio EV6 audio-reactive lighting and launcher; opt-in service, not vehicle verified.",
  "live": true,
  "services": [
    {
      "name": "moon-lighting",
      "script": "moon.sh",
      "user": "root",
      "restart": true,
      "start": "android"
    }
  ],
  "apps": [
    {
      "package": "com.nemesis.moonstudio",
      "apk": "app/MoonStudio.apk"
    }
  ],
  "provides": {
    "launcher": [
      {
        "title": "Moon Studio",
        "package": "com.nemesis.moonstudio",
        "class": ".MoonStudioActivity",
        "icon": "icons/tile.png",
        "icon_night": "icons/tile.png",
        "icon_disabled": "icons/tile_disabled.png",
        "icon_disabled_night": "icons/tile_disabled.png"
      }
    ]
  }
}
