{
  "id": "moon-studio-launcher",
  "name": "Moon Studio Launcher",
  "version": "0.2.1",
  "hmgapi": ">=1.0.0",
  "authors": [
    "Moon Studio contributors"
  ],
  "license": "AGPL-3.0",
  "description": "Launcher-only Moon Studio Concept D interface; no lighting daemon or vehicle writes.",
  "live": true,
  "apps": [
    {
      "package": "com.nemesis.moonstudio",
